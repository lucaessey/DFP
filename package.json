{
  "name": "deep-fried-pixels",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original offline restaurant management game",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "vite build --configLoader native",
    "build:pages": "vite build --configLoader native --base=/DFP/ --outDir dist-pages",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "preview:pages": "vite preview --configLoader native --base=/DFP/ --outDir dist-pages --host 127.0.0.1 --port 4174",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:pages": "node tests/pages-browser.mjs",
    "spec:validate": "openspec validate build-dfp-game --strict",
    "openspec": "openspec",
    "icons": "node scripts/generate-icons.mjs",
    "test:comments:rules": "node tests/people-rules.mjs",
    "test:comments:browser": "node tests/people-browser.mjs",
    "test:comments:auth": "node tests/people-auth-errors-browser.mjs",
    "comments:emulators": "firebase emulators:start --only auth,database --project demo-dfp-comments",
    "comments:local-api": "node tests/people-local-server.mjs",
    "comments:worker:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run",
    "spec:comments": "openspec validate add-people-comments --strict"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fission-ai/openspec": "1.13.1",
    "@playwright/test": "1.58.2",
    "firebase-tools": "^15.32.0",
    "vite": "7.3.6",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "three": "0.186.0"
  }
}
